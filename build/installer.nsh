; Moshi installer: friendly copy, the logo characters on every page, three short steps
; (Hello -> Installing -> Done). Artwork is generated by `npm run installer-art` (scripts/make-installer-art.mjs).

; Per-user install: no admin prompt and no "for whom" page.
!macro customInstallMode
  StrCpy $isForceCurrentInstall "1"
!macroend

; Is Moshi still running? By program name, the current user's "Moshi.exe" only. electron-builder 26 asks instead
; whether any process runs from inside the install folder, and updates kept stopping at "Moshi cannot be closed"
; with no Moshi window or process left. Asks Moshi to close, then ends it, and only asks the user after ~15 s.
!macro customCheckAppRunning
  ; this installer's own process id, never to be ended
  System::Call "kernel32::GetCurrentProcessId() i .R2"
  StrCpy $R1 0
  moshiCheckRunning:
    nsExec::Exec `"$CmdPath" /C tasklist /FI "USERNAME eq %USERNAME%" /FI "IMAGENAME eq ${APP_EXECUTABLE_FILENAME}" /FO CSV /NH | "$SYSDIR\findstr.exe" /B /I /C:"\"${APP_EXECUTABLE_FILENAME}\""`
    Pop $R0
    ${if} $R0 == 0
      IntOp $R1 $R1 + 1
      ${if} $R1 == 1
        DetailPrint "$(appClosing)"
        nsExec::Exec `"$CmdPath" /C taskkill /IM "${APP_EXECUTABLE_FILENAME}" /FI "PID ne $R2" /FI "USERNAME eq %USERNAME%"`
        Sleep 2500
      ${else}
        nsExec::Exec `"$CmdPath" /C taskkill /F /T /IM "${APP_EXECUTABLE_FILENAME}" /FI "PID ne $R2" /FI "USERNAME eq %USERNAME%"`
        Sleep 1500
      ${endif}
      ${if} $R1 < 9
        Goto moshiCheckRunning
      ${endif}
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(appCannotBeClosed)" /SD IDCANCEL IDRETRY moshiCheckAgain
      Quit
      moshiCheckAgain:
        StrCpy $R1 1
        Goto moshiCheckRunning
    ${endif}
    ; files a closed Moshi held are free a moment later
    Sleep 300
!macroend

!ifndef BUILD_UNINSTALLER

; ---------------------------------------------------------------- welcome
!macro customWelcomePage
  Function unisonWelcomeShow
    ; The next page installs straight away, so the button says so.
    GetDlgItem $0 $HWNDPARENT 1
    SendMessage $0 ${WM_SETTEXT} 0 "STR:Cài đặt"
  FunctionEnd

  !define MUI_WELCOMEPAGE_TITLE "Chào bạn, mình là Moshi!"
  !define MUI_WELCOMEPAGE_TEXT "Bộ đôi Moshi sẽ gom Messenger, Instagram, Telegram, Zalo và WhatsApp về chung một nhà, để bạn không bỏ lỡ ai.$\r$\n$\r$\nChỉ mất vài giây, không cần quyền quản trị.$\r$\n$\r$\nBấm Cài đặt để bắt đầu nhé!"
  !define MUI_PAGE_CUSTOMFUNCTION_SHOW unisonWelcomeShow
  !insertmacro MUI_PAGE_WELCOME
!macroend

; ---------------------------------------------------------------- installing
!macro customPageAfterChangeDir
  !define MUI_PAGE_HEADER_TEXT "Bộ đôi đang dọn nhà cho Moshi..."
  !define MUI_PAGE_HEADER_SUBTEXT "Chờ xíu nhé, chỉ vài giây thôi."
  !define MUI_INSTFILESPAGE_FINISHHEADER_TEXT "Dọn xong rồi!"
  !define MUI_INSTFILESPAGE_FINISHHEADER_SUBTEXT "Moshi đã sẵn sàng trên máy bạn."
!macroend

; ---------------------------------------------------------------- done
!macro customFinishPage
  Function StartApp
    ${if} ${isUpdated}
      StrCpy $1 "--updated"
    ${else}
      StrCpy $1 ""
    ${endif}
    ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$1"
  FunctionEnd

  !define MUI_FINISHPAGE_TITLE "Xong rồi! Cả nhà đã sẵn sàng"
  !define MUI_FINISHPAGE_TEXT "Moshi đã được cài vào máy bạn.$\r$\n$\r$\nMở app, kết nối tài khoản đầu tiên và mọi cuộc trò chuyện sẽ về chung một chỗ."
  !define MUI_FINISHPAGE_RUN
  !define MUI_FINISHPAGE_RUN_TEXT "Mở Moshi ngay"
  !define MUI_FINISHPAGE_RUN_FUNCTION "StartApp"
  !define MUI_FINISHPAGE_BUTTON "Hoàn tất"
  !define MUI_PAGE_CUSTOMFUNCTION_SHOW unisonFinishShow
  !insertmacro MUI_PAGE_FINISH

  ; The finish page celebrates with its own picture (MUI uses one bitmap for welcome and finish).
  Function unisonFinishShow
    InitPluginsDir
    File "/oname=$PLUGINSDIR\unison-finish.bmp" "${BUILD_RESOURCES_DIR}\installerFinish.bmp"
    ${NSD_FreeImage} $mui.FinishPage.Image.Bitmap
    ${NSD_SetStretchedImage} $mui.FinishPage.Image "$PLUGINSDIR\unison-finish.bmp" $mui.FinishPage.Image.Bitmap
  FunctionEnd
!macroend

!else

; ---------------------------------------------------------------- uninstall
!macro customUnWelcomePage
  Function un.unisonGoodbyeShow
    GetDlgItem $0 $HWNDPARENT 1
    SendMessage $0 ${WM_SETTEXT} 0 "STR:Gỡ cài đặt"
  FunctionEnd

  !define MUI_WELCOMEPAGE_TITLE "Tạm biệt nhé..."
  !define MUI_WELCOMEPAGE_TEXT "Bộ đôi sẽ nhớ bạn lắm.$\r$\n$\r$\nGỡ Moshi chỉ xoá ứng dụng khỏi máy. Tài khoản đã kết nối, cài đặt và các khoảnh khắc của bạn vẫn được giữ lại, lần sau cài lại là dùng tiếp ngay.$\r$\n$\r$\nBấm Gỡ cài đặt để tiếp tục."
  !define MUI_PAGE_CUSTOMFUNCTION_SHOW un.unisonGoodbyeShow
  !insertmacro MUI_UNPAGE_WELCOME
!macroend

!endif
