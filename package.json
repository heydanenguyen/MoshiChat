{
  "name": "unison",
  "productName": "Unison",
  "version": "0.1.0",
  "description": "All your conversations, in one place. Messenger, Instagram and Telegram in a single Apple-grade inbox.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Dane Nguyen",
    "email": "danenguyenco@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win && node scripts/build-setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "installer-art": "node scripts/make-installer-art.mjs",
    "setup": "node scripts/build-setup.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "lucide-react": "^0.475.0",
    "opus-recorder": "^8.0.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "telegram": "^2.26.22",
    "ws3-fca": "^3.5.2",
    "zca-js": "^2.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.3hvn.unison",
    "productName": "Unison",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-web/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "language": "1066",
      "installerLanguages": [
        "vi_VN"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unison",
      "uninstallDisplayName": "Unison",
      "deleteAppDataOnUninstall": false,
      "artifactName": "unison-core-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@whiskeysockets/baileys/**",
      "node_modules/zca-js/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/stickers",
        "to": "stickers"
      },
      {
        "from": "resources/legal",
        "to": "legal"
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      }
    ]
  }
}
