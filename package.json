{
  "name": "moshi",
  "productName": "Moshi",
  "version": "0.3.1",
  "description": "All your conversations, in one place. Messenger, Instagram and Telegram in a single Apple-grade inbox.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Dane Nguyen",
    "email": "danenguyenco@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "dist": "electron-vite build && electron-builder --win --publish never && node scripts/build-setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "installer-art": "node scripts/make-installer-art.mjs",
    "setup": "node scripts/build-setup.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never && node scripts/build-setup.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "opus-recorder": "^8.0.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "telegram": "^2.26.22",
    "ws3-fca": "^3.5.2",
    "zca-js": "^2.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.danenguyen.moshi",
    "productName": "Moshi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/onnxruntime-web/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "files": [
        "out/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/@img/sharp-{darwin,linux,linuxmusl}*/**",
        "!node_modules/@img/sharp-libvips-{darwin,linux,linuxmusl}*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "language": "1066",
      "installerLanguages": [
        "vi_VN"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moshi",
      "uninstallDisplayName": "Moshi",
      "deleteAppDataOnUninstall": false,
      "artifactName": "moshi-core-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "artifactName": "Moshi-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Moshi uses the microphone only while you record a voice message.",
        "NSCameraUsageDescription": "Moshi does not use the camera."
      },
      "files": [
        "out/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/{win32,linux}/**",
        "!node_modules/@img/sharp-{win32,linux,linuxmusl}*/**",
        "!node_modules/@img/sharp-libvips-{win32,linux,linuxmusl}*/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@whiskeysockets/baileys/**",
      "node_modules/zca-js/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/stickers",
        "to": "stickers"
      },
      {
        "from": "resources/legal",
        "to": "legal"
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      }
    ],
    "dmg": {
      "title": "Moshi",
      "iconSize": 96,
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "https://github.com/heydanenguyen/MoshiChat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heydanenguyen/MoshiChat.git"
  },
  "bugs": {
    "url": "https://github.com/heydanenguyen/MoshiChat/issues"
  }
}
